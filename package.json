{
  "name": "majority-rules-netlify",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Majority Rules in English, Spanish and French, with Netlify Functions and Blobs.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:locales": "node build-locales.mjs",
    "package:function": "node scripts/package-function.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run build && npm run package:function && npm test"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": { "@netlify/blobs": "11.1.3", "@netlify/functions": "6.0.2" },
  "devDependencies": { "@netlify/zip-it-and-ship-it": "16.2.3", "esbuild": "npm:esbuild-wasm@0.28.1" },
  "overrides": { "esbuild": "$esbuild" }
}
